[Unit]
Description=Web Garden local backup job
After=network.target

[Service]
Type=oneshot
User=fluffy
Group=fluffy
WorkingDirectory=/home/fluffy/webgarden-backup
Environment=BACKUP_ROOT=/home/fluffy/backups/webgarden
ExecStart=/home/fluffy/webgarden-backup/backup-webgarden.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
