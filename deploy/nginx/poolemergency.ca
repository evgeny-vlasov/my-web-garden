# Nginx configuration for WebGarden PoolEmergency.
#
# Install only after the local service responds on 127.0.0.1:8003:
#   sudo cp deploy/nginx/poolemergency.ca /etc/nginx/sites-available/poolemergency.ca
#   sudo ln -s /etc/nginx/sites-available/poolemergency.ca /etc/nginx/sites-enabled/poolemergency.ca
#   sudo nginx -t
#   sudo systemctl reload nginx
#   sudo certbot --nginx -d poolemergency.ca -d www.poolemergency.ca

server {
    listen 80;
    listen [::]:80;
    server_name poolemergency.ca www.poolemergency.ca;

    access_log /var/log/nginx/poolemergency-access.log;
    error_log /var/log/nginx/poolemergency-error.log;

    client_max_body_size 5M;
    root /var/www/webgarden/sites/poolemergency;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static {
        alias /var/www/webgarden/sites/poolemergency/static;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /uploads {
        alias /var/www/webgarden/uploads/poolemergency;
        expires 30d;
        add_header Cache-Control "public";
    }

    location = /favicon.ico {
        alias /var/www/webgarden/sites/poolemergency/static/images/favicon.ico;
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        alias /var/www/webgarden/sites/poolemergency/static/robots.txt;
        log_not_found off;
        access_log off;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
}
